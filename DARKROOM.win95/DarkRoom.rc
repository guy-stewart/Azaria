/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG 34, 22, 217, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,18,20
    LTEXT           "YADD Application Version 1.2",IDC_STATIC,40,10,119,8
    LTEXT           "Copyright © 1992-1996",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,176,6,32,14,WS_GROUP
END

IDD_FRAMES DIALOG 0, 0, 167, 95
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Frames in Animation Sequence"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,25,74,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,91,74,50,14
    EDITTEXT        IDC_FRAMECOUNT,97,18,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Frame Count: ",IDC_STATIC,31,21,45,8
    EDITTEXT        IDC_FRAMEPER10SECS,97,41,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Frame Per 10 Seconds: ",IDC_STATIC,29,45,45,8
END


