// Some handy color definitions:
// 	    Color    index
//		-----    -----

#define BLACK	  0
#define RED		  249
#define BLUE	  252
#define TEAL_1	  57
#define TEAL_2	  58
#define TEAL_3	  59
#define TEAL_4	  60
#define YELLOW	  114
#define GOLD	  64

#define WHITE	  255
#define GREEN	  85

//------------------------------------
// Available fonts:

#define IDS_FONTENG				0x00a0
#define IDS_FONTPAR				0x00a1
#define IDS_FONTVILL			0x00a2
#define IDS_FONTCITY			0x00a3

#define IDS_FONTENG_BIG			0x00a4
#define IDS_FONTPAR_BIG			0x00a5
#define IDS_FONTVILL_BIG		0x00a6
#define IDS_FONTCITY_BIG		0x00a7

#define IDS_FONTTNR12			0x00a8
#define IDS_FONTTNR14			0x00a9
#define IDS_FONTTNR16			0x00aa
#define IDS_FONTTNR18			0x00ab

#define IDS_FONTTNB12			0x00ac
#define IDS_FONTTNB14			0x00ad
#define IDS_FONTTNB16			0x00ae
#define IDS_FONTTNB18			0x00af

#define OFF -1


[COMMON] // Text displayed for every object or class
  FONT IDS_FONTTNB16
  SETY 200
  SETX 480
  COLOR BLUE
  SHADOW OFF
    ? Search_Item

  // set default font for everyone
  COLOR GOLD
  SHADOW BLACK
  FONT IDS_FONTTNB18
  LINE 3 CENTER

[NEELP]


if (vm.S24_RATHE.bparm EQ 21)
  {
    "Rathe has requested a green Gopa berry."

    PLAY "M6g2i"
    vm.SOD_ID.wParm = 38 
    SIGNAL SOD_ID SIG_MEFLIN
  }


  if (vm.S24_RATHE.bparm EQ 20)
  {
    "Rathe is offering you a once in a lifetime"
    "enlightenment special"
	""
    "Bring to me a green Gopa berry for my brew. If you"
    "bring it to me, I will reward you."

    PLAY "M6g2a"
    vm.SOD_ID.wParm = 38 
    SIGNAL SOD_ID SIG_MEFLIN
    vm.S24_RATHE.bParm = 21
  }

  if (vm.S24_RATHE.bparm EQ 12)
  {
   
	"Rathe recognizes you and wishes"
	"to know if you have brought his"
	"plant."

    PLAY "M6g1i"

    vm.SOD_ID.wParm = 36 
    SIGNAL SOD_ID SIG_MEFLIN
  }

  if (vm.S24_RATHE.bparm EQ 11)
  {
    "Rathe the Meflin imparts these words:"
	""
	"Take these seeds and plant them in the shade."
	"A plant will grow if they are cared for."
	"BRING ME THE PLANT...and I will make it worth"
	"your while."
    PLAY "M6g1a"


    vm.SOD_ID.wParm = 39 
    SIGNAL SOD_ID SIG_MEFLIN
    vm.S24_RATHE.bParm = 12

	//Rathe gives the seeds
	vm.S1e_bin01.wObject = IDD_BAGOSEED
	signal s1e_bin01 sig_open	


  }

  if (vm.S24_RATHE.bparm EQ 10)
  {
    "Rathe has little patience as he inquires  "
    "about your quest.  "

    PLAY "M6m1i"
   		   
   vm.SOD_ID.wParm = 37
   SIGNAL SOD_ID SIG_MEFLIN
  }


  if (vm.S24_RATHE.bparm LTE 0)
  {
    "Rathe the meflin is sending you"
    "on a dangerous quest to find the"
    "Emerald of Light. You must make a"
    "journey to the center of Azaria"
    "and seek out the dark lake.  If"
    "you complete the quest Rathe will"
    "be more than grateful."
   PLAY "M6m1a"
   
   vm.S24_RATHE.bParm = 10

   vm.SOD_ID.wParm = 69
   SIGNAL SOD_ID SIG_MEFLIN
   
  }













[TOOR]
	"I am TOOR"

[RATHE]
	"I am RATHE"

[THAOR]
	"I am THAOR"

[EYTH]
	"I am EYTH"

[NROC]
	"I am NROC"

[PERST]
	"I am PERST"

/* End Of File */

