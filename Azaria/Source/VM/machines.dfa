


class TRANSITION {
    next_state;
    input;
    output;
    code;
}
class STATE {
    id;
    show;
    on_enter;
    on_exit;
    transitions[];
};

class DFA {
    name
    state
    states[]
}

M24_EYEPLATE {
	S0: show(empty) [
        on (DROP, 0, IDD_EYEFUSE) {
            SIGNALi, 0, S24_BIGEYE;
        } => S4;
    ];

    S4: show(IDS_EYEPLATE, animate) [
        on (DROP, CLASS, IDC_BOMB) {
	        VIDEO, 0, IDS_EXPLODE1;
	        PLAYWAVE, 0, SOUND_EXPLODE;
	        SIGNALi, SIG_BOMB, S24_BIGEYE;
        } => S0;
    ];
}



