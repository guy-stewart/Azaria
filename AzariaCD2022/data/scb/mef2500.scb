// Some handy color definitions:
// 	    Color    index
//		-----    -----

#define BLACK	  0
#define RED		  249
#define BLUE	  252
#define TEAL_1	  57
#define TEAL_2	  58
#define TEAL_3	  59
#define TEAL_4	  60
#define YELLOW	  114
#define GOLD	  64

#define WHITE	  255
#define GREEN	  85

//------------------------------------
// Available fonts:

#define IDS_FONTENG				0x00a0
#define IDS_FONTPAR				0x00a1
#define IDS_FONTVILL			0x00a2
#define IDS_FONTCITY			0x00a3

#define IDS_FONTENG_BIG			0x00a4
#define IDS_FONTPAR_BIG			0x00a5
#define IDS_FONTVILL_BIG		0x00a6
#define IDS_FONTCITY_BIG		0x00a7

#define IDS_FONTTNR12			0x00a8
#define IDS_FONTTNR14			0x00a9
#define IDS_FONTTNR16			0x00aa
#define IDS_FONTTNR18			0x00ab

#define IDS_FONTTNB12			0x00ac
#define IDS_FONTTNB14			0x00ad
#define IDS_FONTTNB16			0x00ae
#define IDS_FONTTNB18			0x00af

#define OFF -1


[COMMON] // Text displayed for every object or class
  FONT IDS_FONTTNB16
  SETY 200
  SETX 480
  COLOR BLUE
  SHADOW OFF
    ? Search_Item

  // set default font for everyone
  COLOR GOLD
  SHADOW BLACK
  FONT IDS_FONTTNB18
  LINE 3 CENTER

[NEELP]


if (vm.S25_TOOR.bparm EQ 21)
  {
    "Toor has requested a blue Gopa berry."

    
    vm.SOD_ID.wParm = 138 
    SIGNAL SOD_ID SIG_MEFLIN
    PLAY "Msm3i"
  }


  if (vm.S25_TOOR.bparm EQ 20)
  {
    "Each bottle of Gopa is brewed slowly, with the"
    "greatest attention to detail."
  
    "Toor would like to have a blue Gopa berry for the"
    "particular batch he is brewing."


    vm.SOD_ID.wParm = 138
    SIGNAL SOD_ID SIG_MEFLIN
   
	vm.S25_TOOR.bParm = 21

    PLAY "Msm3a"

  }




  if (vm.S25_TOOR.bparm EQ 12)
  {
	"Toor is anxiously awaiting the arrival"
	"of the sacred goblet."

    vm.SOD_ID.wParm = 114 
    SIGNAL SOD_ID SIG_MEFLIN
    PLAY "MSm2i"
  }



  if (vm.S25_TOOR.bparm EQ 11)
  {
    "Toor the Meflin imparts these words:"
	""
	"A beutiful goblet is the center of one of our"
	"oldest Gopa rituals.  Durring the last ritual,"
	"we misplaced it - but the ceremony was so long"
	"ago, none of us remember where we held it."
	"You must find the goblet for us and bring it"
	"to me!"

    vm.SOD_ID.wParm = 109
    SIGNAL SOD_ID SIG_MEFLIN

    vm.S25_TOOR.bParm = 12
    PLAY "MSm2a"

  }



  if (vm.S25_TOOR.bparm EQ 10)
  {
    "Toor has requested a particular object to be produced."
    "He is curious about your progress.  "

   		   
   vm.SOD_ID.wParm = 108
   SIGNAL SOD_ID SIG_MEFLIN

   PLAY "MSm1i"


  }


  if (vm.S25_TOOR.bparm LTE 0)
  {

	"Toor the Meflin is giving you a strange"
	"tablet.  You must take the tablet to the"
	"city of Niret and bring back the object"
	"it defines."
   
	vm.S1e_bin01.wObject = IDD_TEMPLATE40
	signal s1e_bin01 sig_open	

	vm.S25_TOOR.bParm = 10

   	vm.SOD_ID.wParm = 125
	SIGNAL SOD_ID SIG_MEFLIN
   
	PLAY "Msm1a"

   
  }














