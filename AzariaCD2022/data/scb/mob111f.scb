// Some handy color definitions:
// 	    Color    index
//		-----    -----

#define BLACK	  0
#define RED		  249
#define BLUE	  252
#define TEAL_1	  57
#define TEAL_2	  58
#define TEAL_3	  59
#define TEAL_4	  60
#define YELLOW	  114
#define GOLD	  64

#define WHITE	  255
#define GREEN	  85

//------------------------------------
// Available fonts:

#define IDS_FONTENG				0x00a0
#define IDS_FONTPAR				0x00a1
#define IDS_FONTVILL			0x00a2
#define IDS_FONTCITY			0x00a3

#define IDS_FONTENG_BIG			0x00a4
#define IDS_FONTPAR_BIG			0x00a5
#define IDS_FONTVILL_BIG		0x00a6
#define IDS_FONTCITY_BIG		0x00a7

#define IDS_FONTTNR12			0x00a8
#define IDS_FONTTNR14			0x00a9
#define IDS_FONTTNR16			0x00aa
#define IDS_FONTTNR18			0x00ab

#define IDS_FONTTNB12			0x00ac
#define IDS_FONTTNB14			0x00ad
#define IDS_FONTTNB16			0x00ae
#define IDS_FONTTNB18			0x00af

#define OFF -1


[COMMON] // Text displayed for every object or class
  FONT IDS_FONTTNB16
  SETY 200
  SETX 480
  COLOR BLUE
  SHADOW OFF
    ? Search_Item

  // set default font for everyone
  COLOR GOLD
  SHADOW BLACK
  FONT IDS_FONTTNB18
  LINE 3 CENTER

[NEELP]

if (vm.s33_NEELP.bparm EQ 10)
{
  IF (VM.SOD_SPELL.WOBJECT EQ IDD_AMULET1)	//object satisfies
  {
    if (vm.S33_LEVER.bstate GTE 70)
    {
	    "Neelp offers you this wisdom in addition"
	    "to more material rewards: "
	    ""
	    "You would do well to travel as the ancients"
	    "did to the center of our world to see the"
	    "place where time stands still." 
    }
    if  (vm.S33_LEVER.bstate LT 70)
    {
	    "Neelp offers you this wisdom in addition"
	    "to more material rewards: "
	    ""
 	    "The ancients have written directions everywhere"  
    }

    PLAY "neelps1"	//satisfied

    vm.S33_NEELP.bParm = 11
    
    vm.SOD_ID.wParm = 19 
    SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_BOMB2
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	vm.S1e_bin03.wObject = IDD_BOMB2
	signal s1e_bin03 sig_open	



    exit
  }	
}


if (vm.s33_NEELP.bparm EQ 12)
{
    IF (VM.SOD_SPELL.WOBJECT EQ IDD_SPRINGS)	//object satisfies
     {
	"Neelp is pleased by your efforts."
	"In return for the fish soul, he"
	"offers you 3 spells."
	 	
       PLAY "neelpgs1"	//satisfied
       vm.SOD_ID.wParm = 1 
       SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_PROTECT
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_BLINDNESS
	signal s1e_bin02 sig_open	

	vm.S1e_bin03.wObject = IDD_BANISHMENT
	signal s1e_bin03 sig_open	

       vm.S33_NEELP.bParm = 20	
       exit	
     }	
}

if (vm.s33_NEELP.bparm EQ 21)
{
    IF (VM.SOD_SPELL.WOBJECT EQ IDD_GOPAR)	//object satisfies
     {
	"Neelp needed the Red berry to finish"
	"his latest batch of Gopa.  He is so"
	"pleased that he offers you 3 vials of"
	"Gopa."
	 	
       PLAY "neelpgs2"	//satisfied
       vm.SOD_ID.wParm = 9 
       SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_GVIAL
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	vm.S1e_bin03.wObject = IDD_GVIAL
	signal s1e_bin03 sig_open	
	
       vm.S33_NEELP.bParm = 0	
       exit	
     }	
}

   IF (VM.SOD_SPELL.WCLASS EQ IDC_FISH)	
     {
	"Neelp thanks you for the fish and offers you"
	"a small token of his appreciation"	
	
	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	PLAY "neelpfsh"
	vm.SOD_ID.wParm = 6 
    	SIGNAL SOD_ID SIG_MEFLIN
     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_BOMB)	
     
     {
	"Neelp thanks you for the bomb and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_BANISHMENT
	signal s1e_bin02 sig_open	


	
	PLAY "neelpbmb"
	vm.SOD_ID.wParm = 2 
   	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_SPELL)	
     
     {
	"Neelp thanks you for the spell and offers you"
	"a small token of his appreciation"	


	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	vm.S1e_bin05.wObject = IDD_GVIAL
	signal s1e_bin05 sig_open	

	
	PLAY "neelpspl"
	vm.SOD_ID.wParm = 9
    	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_PLANT)	
     
     {
	"Neelp thanks you for the plant and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_BAIT2
	signal s1e_bin02 sig_open	
	
	vm.S1e_bin05.wObject = IDD_BAIT4
	signal s1e_bin05 sig_open	

	
	PLAY "neelppln"
	vm.SOD_ID.wParm = 1 
    	SIGNAL SOD_ID SIG_MEFLIN

     }


   IF (VM.SOD_SPELL.WCLASS EQ IDC_BAIT)	
   {
        "Neelp thanks you for the bait and offers you"
        "a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_FISH1
	signal s1e_bin02 sig_open	


        PLAY "neelpbat"
        vm.SOD_ID.wParm = 1 
        SIGNAL SOD_ID SIG_MEFLIN

   }


   IF (VM.SOD_SPELL.WCLASS EQ IDC_GOPA)	
     
     {
	"Neelp thanks you for the gopa berry and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_BAIT5
	signal s1e_bin02 sig_open	

	
	PLAY "neelpgop"
	vm.SOD_ID.wParm = 3
    	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_MAGIC)	
     
     {
	"Neelp thanks you for the magical item and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	

	PLAY "neelpmag"
	vm.SOD_ID.wParm = 9
    	SIGNAL SOD_ID SIG_MEFLIN

     }


[TOOR]
	"I am TOOR"

[RATHE]
	"I am RATHE"

[THAOR]
	"I am THAOR"

[EYTH]
	"I am EYTH"

[NROC]
	"I am NROC"

[PERST]
	"I am PERST"

