// Some handy color definitions:
// 	    Color    index
//		-----    -----

#define BLACK	  0
#define RED		  249
#define BLUE	  252
#define TEAL_1	  57
#define TEAL_2	  58
#define TEAL_3	  59
#define TEAL_4	  60
#define YELLOW	  114
#define GOLD	  64

#define WHITE	  255
#define GREEN	  85

//------------------------------------
// Available fonts:

#define IDS_FONTENG				0x00a0
#define IDS_FONTPAR				0x00a1
#define IDS_FONTVILL			0x00a2
#define IDS_FONTCITY			0x00a3

#define IDS_FONTENG_BIG			0x00a4
#define IDS_FONTPAR_BIG			0x00a5
#define IDS_FONTVILL_BIG		0x00a6
#define IDS_FONTCITY_BIG		0x00a7

#define IDS_FONTTNR12			0x00a8
#define IDS_FONTTNR14			0x00a9
#define IDS_FONTTNR16			0x00aa
#define IDS_FONTTNR18			0x00ab

#define IDS_FONTTNB12			0x00ac
#define IDS_FONTTNB14			0x00ad
#define IDS_FONTTNB16			0x00ae
#define IDS_FONTTNB18			0x00af

#define OFF -1

[COMMON] // Text displayed for every object or class
  FONT IDS_FONTTNB16
  SETY 260
  SETX 480
  COLOR BLUE
  SHADOW OFF
    ? Search_Item

  // set default font for everyone
  COLOR GOLD
  SHADOW BLACK
  FONT IDS_FONTTNB18
  LINE 3 CENTER

[IDD_SCOOPE IDD_SCOOPF]
    PLAY "vor04b"

	"The Kusadi is an ancient tool used for"
	"the containment of Nystram - the currency of Azaria."

  // split up for the remainder ...
  FONT IDS_FONTTNR12
  LINE 10 SHADOW RED COLOR 250

  [IDD_SCOOPE]
	"(Your scoop is EMPTY)"

  [IDD_SCOOPF]
    "(Your scoop is FULL)"

 
[IDD_YMUSHSPT]
    "A Yellow Mushroom"

[IDD_MATCH]
	"A burning match"

