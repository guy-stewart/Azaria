// Some handy color definitions:
// 	    Color    index
//		-----    -----

#define BLACK	  0
#define RED		  249
#define BLUE	  252
#define TEAL_1	  57
#define TEAL_2	  58
#define TEAL_3	  59
#define TEAL_4	  60
#define YELLOW	  114
#define GOLD	  64

#define WHITE	  255
#define GREEN	  85

//------------------------------------
// Available fonts:

#define IDS_FONTENG				0x00a0
#define IDS_FONTPAR				0x00a1
#define IDS_FONTVILL			0x00a2
#define IDS_FONTCITY			0x00a3

#define IDS_FONTENG_BIG			0x00a4
#define IDS_FONTPAR_BIG			0x00a5
#define IDS_FONTVILL_BIG		0x00a6
#define IDS_FONTCITY_BIG		0x00a7

#define IDS_FONTTNR12			0x00a8
#define IDS_FONTTNR14			0x00a9
#define IDS_FONTTNR16			0x00aa
#define IDS_FONTTNR18			0x00ab

#define IDS_FONTTNB12			0x00ac
#define IDS_FONTTNB14			0x00ad
#define IDS_FONTTNB16			0x00ae
#define IDS_FONTTNB18			0x00af

#define OFF -1


[COMMON] // Text displayed for every object or class
  FONT IDS_FONTTNB16
  SETY 200
  SETX 480
  COLOR BLUE
  SHADOW OFF
    ? Search_Item

  // set default font for everyone
  COLOR GOLD
  SHADOW BLACK
  FONT IDS_FONTTNB18
  LINE 3 CENTER

[NEELP]

if (vm.s24_RATHE.bparm EQ 10)
{
  IF (VM.SOD_SPELL.WOBJECT EQ IDD_EMERALD)	//object satisfies
  {
    if (vm.S33_LEVER.bstate GTE 70) // THE EOG IS SOLVED
    {
	"Rathe has this piece of wisdom to offer you:"
	""
	"The Ancients left their marks on many things"
	"of this world and the means for you to someday"
	"understand your destiny.  Use the eye from the"
	"center of the pyramid to read the writings of"
	"your past."
    }


    if  (vm.S33_LEVER.bstate LT 70) // THE EOG NEEDS SOLVING
    {
	"Rathe has this piece of wisdom to offer you:"
	""
	"Finding balance is the key to enlightenment."
	"One element of spirit and one of mind - Each"
	"rests together in the northern hills."	

    }

    PLAY "m6m1s"	//satisfied

    vm.S24_RATHE.bParm = 11
    
    vm.SOD_ID.wParm = 50 
    SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_GVIAL
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

    exit
  }	
}


if (vm.s24_RATHE.bparm EQ 12)
{
    IF (VM.SOD_SPELL.WOBJECT EQ IDD_AMULET1)	//object satisfies CITYPLANT
     {
	"Rathe is pleased by your efforts."
	"The plant you have brought will give"
	"his gopa great flavor."
	 	
       PLAY "M6G1S"	//satisfied
       vm.SOD_ID.wParm = 42 
       SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_PROTECT
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_PROTECT
	signal s1e_bin02 sig_open	

	vm.S1e_bin03.wObject = IDD_PROTECT
	signal s1e_bin03 sig_open	

       vm.S24_RATHE.bParm = 20	
       exit	
     }	
}

if (vm.s24_RATHE.bparm EQ 21)
{
    IF (VM.SOD_SPELL.WOBJECT EQ IDD_GOPAG)   //object satisfies
     {
	
	"Green Gopa berries give the brew"
	"Its bitter taste - but after all,"
	"isn't that what drinking Gopa is"
        "all about?"
 	
       PLAY "M6G2S"	//satisfied
       vm.SOD_ID.wParm = 44 
       SIGNAL SOD_ID SIG_MEFLIN

	vm.S1e_bin01.wObject = IDD_GVIAL
	signal s1e_bin01 sig_open	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	vm.S1e_bin03.wObject = IDD_GVIAL
	signal s1e_bin03 sig_open	
	
       vm.S24_RATHE.bParm = 0	
       exit	
     }	
}


//---------GENERIC ITEMS-----------------------------------

   IF (VM.SOD_SPELL.WCLASS EQ IDC_FISH)	
     {
	"Rathe is not partial to the smell of fish."
	
	vm.S1e_bin02.wObject = IDD_BAIT1
	signal s1e_bin02 sig_open	

	PLAY "M6VFISH"
	vm.SOD_ID.wParm = 37
    	SIGNAL SOD_ID SIG_MEFLIN
     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_BOMB)	
     
     {
	"Rathe quickly difuses the bomb and"
	"and offers you something safer to"
	"play with."

	vm.S1e_bin02.wObject = IDD_ENCHAN
	signal s1e_bin02 sig_open	

	PLAY "M6VBOMB"
	vm.SOD_ID.wParm = 45 
   	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_SPELL)	
     
     {
	"Rathe thanks you for the spell"
	"and offers you items in return"

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	
	
	PLAY "M6vspell"
	vm.SOD_ID.wParm = 50
    	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_PLANT)	
     
     {
	"Not interested in your plant,"
	"Rathe still offers you something"
	"just to be the nice guy he is."

	vm.S1e_bin02.wObject = IDD_BAIT5
	signal s1e_bin02 sig_open	
	
	
	PLAY "m6vlots"
	vm.SOD_ID.wParm = 40 
    	SIGNAL SOD_ID SIG_MEFLIN

     }


   IF (VM.SOD_SPELL.WCLASS EQ IDC_BAIT)	
   {
        "Rathe thanks you for the bait and offers you"
        "a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_FISH2
	signal s1e_bin02 sig_open	


        PLAY "m6vbait"
        vm.SOD_ID.wParm = 36 
        SIGNAL SOD_ID SIG_MEFLIN

   }


   IF (VM.SOD_SPELL.WCLASS EQ IDC_GOPA)	
     
     {
	"Rathe thanks you for the gopa berry and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_alarm
	signal s1e_bin02 sig_open	

	
	PLAY "m6vnot"
	vm.SOD_ID.wParm = 43
    	SIGNAL SOD_ID SIG_MEFLIN

     }

   IF (VM.SOD_SPELL.WCLASS EQ IDC_MAGIC)	
     
     {
	"Rathe thanks you for the magical item and offers you"
	"a small token of his appreciation"	

	vm.S1e_bin02.wObject = IDD_GVIAL
	signal s1e_bin02 sig_open	

	

	PLAY "m6vmagc"
	vm.SOD_ID.wParm = 43
    	SIGNAL SOD_ID SIG_MEFLIN

     }


[TOOR]
	"I am TOOR"

[RATHE]
	"I am RATHE"

[THAOR]
	"I am THAOR"

[EYTH]
	"I am EYTH"

[NROC]
	"I am NROC"

[PERST]
	"I am PERST"

